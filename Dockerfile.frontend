# ============================================================
# VoxCPM Frontend — Next.js 16 Standalone
# ============================================================
# Multi-stage build: deps → builder → runner
#
# Build:  docker build -f Dockerfile.frontend -t voxcpm-frontend .
# Run:    docker run -p 3000:3000 -e DATABASE_URL=file:/data/app.db voxcpm-frontend
# ============================================================

# ---------- Stage 1: deps ----------
FROM node:20-alpine AS deps
WORKDIR /app

# Note: using `npm install` instead of `npm ci` because package-lock.json
# is gitignored in this repo. If you commit package-lock.json, switch to `npm ci`.
COPY web/package.json ./
COPY web/package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

# ---------- Stage 2: builder ----------
FROM node:20-alpine AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY web/ ./

# Remove dev-only files before build
RUN rm -f test-prisma.ts CLAUDE.md AGENTS.md README.md

# Set build-time env vars
ARG TTS_BACKEND_URL=http://backend:8808
ENV TTS_BACKEND_URL=${TTS_BACKEND_URL}
ARG NEXT_PUBLIC_TTS_API_BASE=/tts_api
ENV NEXT_PUBLIC_TTS_API_BASE=${NEXT_PUBLIC_TTS_API_BASE}

# Generate Prisma client and build Next.js
RUN npx prisma generate && npm run build

# ---------- Stage 3: runner ----------
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup -S app && adduser -S app -G app

# Copy standalone build output
COPY --from=builder --chown=app:app /app/.next/standalone ./
COPY --from=builder --chown=app:app /app/.next/static ./.next/static
COPY --from=builder --chown=app:app /app/public ./public

# Copy Prisma files needed at runtime
COPY --from=builder --chown=app:app /app/prisma ./prisma
COPY --from=builder --chown=app:app /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder --chown=app:app /app/node_modules/@prisma ./node_modules/@prisma
COPY --from=builder --chown=app:app /app/node_modules/@libsql ./node_modules/@libsql
COPY --from=builder --chown=app:app /app/node_modules/dotenv ./node_modules/dotenv
COPY --from=builder --chown=app:app /app/prisma.config.ts ./prisma.config.ts
COPY --from=builder --chown=app:app /app/package.json ./package.json

# Copy serverExternalPackages (not bundled by Next.js standalone)
COPY --from=builder --chown=app:app /app/node_modules/jose ./node_modules/jose
COPY --from=builder --chown=app:app /app/node_modules/bcryptjs ./node_modules/bcryptjs
COPY --from=builder --chown=app:app /app/node_modules/svg-captcha ./node_modules/svg-captcha

# Create data directory for SQLite DB
RUN mkdir -p /data && chown -R app:app /data

USER app
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/ >/dev/null || exit 1

# Start Next.js standalone server
CMD ["node", "server.js"]
