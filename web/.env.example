# === Database ===
# Đường dẫn tới file SQLite local (Prisma)
DATABASE_URL="file:./prisma/dev.db"

# === Authentication ===
# Secret key dùng để ký JWT session tokens cho user login
AUTH_JWT_SECRET="change-me-in-production"

# === TTS Backend ===
# URL của FastAPI backend (Python) — mặc định chạy ở cổng 8808
NEXT_PUBLIC_TTS_API_BASE="http://127.0.0.1:8808/api/tts"

# === Internal Secret (BẮT BUỘC) ===
# Secret dùng để xác thực giữa Next.js server và FastAPI backend.
# Cả Next.js (.env.local) VÀ FastAPI (biến môi trường TTS_INTERNAL_SECRET) phải dùng CÙNG giá trị.
# Nếu thiếu hoặc không khớp:
#   - Batch generate sẽ fail (401 Unauthorized)
#   - Streaming token sẽ bị reject
#   - History save sẽ fail (không fetch được audio từ backend)
TTS_INTERNAL_SECRET="dev-internal-secret-change-me"

# === Cloudflare R2 Storage ===
# Dùng để lưu trữ file audio (History, Voice Library).
# Nếu để trống: TTS vẫn chạy nhưng History và Voice Library sẽ không lưu được.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
